# Application
APP_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# MongoDB (required)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=animal-record

# JWT (required; use long, independent secrets outside local development)
JWT_SECRET=replace-with-a-secure-access-token-secret
JWT_EXPIRATION_TIME=1h
JWT_REFRESH_SECRET=replace-with-a-different-secure-refresh-token-secret
JWT_REFRESH_EXPIRATION_TIME=30d

# Verification and recovery
VERIFICATION_CODE_EXPIRATION_MINUTES=15
RESET_PASSWORD_EXPIRATION_MINUTES=15
RESET_PIN_EXPIRATION_MINUTES=15

# Social authentication and Android SMS verification
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
ANDROID_APP_HASH=

# Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Animal Record <noreply@example.com>"

# AWS shared configuration
# Access keys are required by the current Lightsail deployment. Never commit
# real credentials. AWS_SESSION_TOKEN is only used with temporary credentials.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_SNS_SENDER_ID=AnimalRec

# Amazon S3
AWS_S3_BUCKET_NAME=animal-record-profile-pictures
AWS_S3_REGION=us-east-1

# Amazon Bedrock Data Automation (required for medical-document analysis)
AWS_BDA_REGION=us-east-1
AWS_BDA_PROFILE_ARN=arn:aws:bedrock:us-east-1:123456789012:data-automation-profile/us.data-automation-v1
AWS_BDA_PROJECT_ARN=arn:aws:bedrock:us-east-1:123456789012:data-automation-project/replace-with-project-id

# Optional legacy relational database configuration
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SCHEMA=public
DATABASE_SYNCHRONIZE=false
